{
  "name": "cedar-pr-review",
  "version": "0.1.0",
  "description": "Partition a GitHub PR into architectural micro-reviews, then emit a composite review",
  "type": "module",
  "bin": {
    "cedar-review": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js & vite",
    "dev:web": "vite",
    "dev:api": "node --watch src/server.js",
    "dev:cursor-bridge": "node cursor-bridge/server.mjs",
    "build:web": "vite build",
    "preview": "vite preview",
    "review": "node src/cli.js review",
    "lint": "node --check src/cli.js && node --check src/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@cursor/sdk": "^1.4.2",
    "@dagrejs/dagre": "^3.1.3",
    "@octokit/rest": "^21.1.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@viz-js/viz": "^3.31.0",
    "@xyflow/react": "^13.0.2",
    "commander": "^13.1.0",
    "cors": "^2.8.6",
    "cytoscape": "^3.35.0",
    "cytoscape-dagre": "^4.1.0",
    "cytoscape-fcose": "^2.2.0",
    "dependency-cruiser": "^18.8.0",
    "diff2html": "^3.4.56",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "java-parser": "^3.0.1",
    "mermaid": "^12.3.0",
    "minimatch": "^10.0.1",
    "node-sql-parser": "^5.4.0",
    "react": "^19.3.1",
    "react-arborist": "^4.0.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.1",
    "sourceflow": "file:packages/sourceflow",
    "svg-pan-zoom": "^3.6.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}

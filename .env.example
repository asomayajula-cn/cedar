# GitHub PAT — reading PRs + posting slice/PR reviews (Approve buttons)
# Fine-grained: repo access + Pull requests (Read and write) + Contents (Read)
# Classic: scope "repo" (private) or "public_repo" (public only)
# Org repos: authorize SSO on the token in GitHub Settings
GITHUB_TOKEN=ghp_...

# OpenRouter — AI breakouts + per-slice review (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# auto | ai | yaml (auto uses AI when OPENROUTER_API_KEY is set)
CEDAR_PARTITION_MODE=auto

PORT=3847
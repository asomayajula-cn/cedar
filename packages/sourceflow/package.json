{
  "name": "sourceflow",
  "version": "0.1.0",
  "description": "Structure + behavior maps for SQL, Java, and JS/TS — parse in Node, render in React",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/cedar",
    "directory": "packages/sourceflow"
  },
  "keywords": [
    "react",
    "xyflow",
    "code-map",
    "ast",
    "sql",
    "java",
    "typescript",
    "visualization",
    "structure"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react/index.d.ts",
      "default": "./src/react/index.js"
    },
    "./styles.css": "./src/react/sourceflow.css"
  },
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@dagrejs/dagre": "^3.1.3",
    "@xyflow/react": "^13.0.2",
    "java-parser": "^3.0.1",
    "node-sql-parser": "^5.4.0"
  },
  "scripts": {
    "test:parse": "node --test test/parse.test.js"
  }
}